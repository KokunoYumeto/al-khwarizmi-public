  {
   "id": "AK07-J0020-L10",
   "n": 10,
   "kind": "indent",
   "text": "Auch {sp:Al-Battānī} hat 919. 12 statt 920. 0, und die letzte Zeile fehlt bei ihm.",
   "cells": null,
   "pages": null,
   "tables": null,
   "margin": null,
